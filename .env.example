# Domain pointing at this VPS (A record -> VPS IP) for automatic HTTPS.
# No domain yet? Use DOMAIN=:80 and open http://<VPS-IP> (no HTTPS - token travels in clear text).
DOMAIN=astro.example.com

# Password for the app: paste it into the "App token" box in the UI.
# Generate one with: openssl rand -hex 24
APP_TOKEN=change-me

# Zerodha Kite Connect credentials (access token expires daily).
KITE_API_KEY=
KITE_ACCESS_TOKEN=
